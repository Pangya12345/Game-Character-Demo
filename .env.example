# ---------------------------------------------------------------
# Haggle Market — environment variables
# Copy this file to .env and fill in ONE of the API keys below.
# ---------------------------------------------------------------

# Which LLM to use: gemini | anthropic | offline
# Leave empty to auto-pick (Gemini if GEMINI_API_KEY is set, else Claude, else offline demo mode)
LLM_PROVIDER=

# Google Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Used automatically when the main model is overloaded (HTTP 503) or out of quota (429)
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Anthropic Claude — get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Cheaper/faster alternative: claude-haiku-4-5-20251001

# Game tuning (optional)
# Secret lowest price (baht/kg) the vendor will ever accept
FLOOR_PRICE=80
# Max number of player messages before the vendor gives up
MAX_TURNS=12
# Seconds of silence before the vendor gets impatient
IDLE_SECONDS=25

# Local server port (Render sets this automatically)
PORT=3000
